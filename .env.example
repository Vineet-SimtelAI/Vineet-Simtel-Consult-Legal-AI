# ============================================
# ConsultLegal - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# ---- Database ----
# PostgreSQL (Prisma ORM - structured data)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/consultlegal?schema=public"

# MongoDB (Mongoose - chat, docs, analytics)
MONGODB_URI="mongodb://localhost:27017/consultlegal"

# Redis (ioredis - cache, sessions, OTP, queues)
REDIS_URL="redis://localhost:6379"

# ---- NextAuth (JWT Authentication) ----
NEXTAUTH_SECRET="change-me-to-a-random-string-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="change-me-to-a-random-string-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# ---- Google OAuth ----
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ---- AWS SNS (OTP Delivery) ----
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"

# ---- MinIO / S3 (File Storage) ----
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="consultlegal"

# ---- Razorpay (Payments) ----
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# ---- AI Provider (Chat & Document Generation) ----
AI_API_KEY="your-openai-api-key"
AI_MODEL="gpt-4"

# ---- API Backend ----
API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
